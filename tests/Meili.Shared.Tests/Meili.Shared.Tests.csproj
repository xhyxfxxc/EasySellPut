<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral tests for Meili.Shared: run on Windows, macOS and Linux (no WPF, no Avalonia). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Meili.Shared.Services" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Meili.Shared\Meili.Shared.csproj" />
  </ItemGroup>
</Project>
