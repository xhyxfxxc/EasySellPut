<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure, dependency-free analytics: technical indicators, Black-Scholes-Merton, implied volatility, option strategy P/L.
       Nullable / ImplicitUsings / LangVersion come from the repo-level Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TyuStock.Analytics</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Key public members are documented; don't fail the build on every trivial member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TyuStock.Analytics.Tests" />
  </ItemGroup>
</Project>