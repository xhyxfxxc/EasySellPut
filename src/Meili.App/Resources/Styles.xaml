<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:svc="clr-namespace:Meili.App.Services">
    <svc:InverseBoolConverter x:Key="InverseBool" />
    <svc:BoolToVisConverter x:Key="BoolToVis" />
    <svc:BoolToVisConverter x:Key="InverseBoolToVis" Invert="True" />
    <svc:NonEmptyToVisConverter x:Key="NonEmptyToVis" />
    <svc:HealthIconConverter x:Key="HealthIcon" />
    <!-- Typography: nothing in the app is smaller than 12px. -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="NumberFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SubtitleFontSize">16</sys:Double>
    <sys:Double x:Key="TitleFontSize">20</sys:Double>
    <sys:Double x:Key="DisplayFontSize">28</sys:Double>

    <!-- Defaults match ThemePalette.Dark; ThemeService overwrites every key after a theme apply. -->
    <SolidColorBrush x:Key="UpBrush" Color="#CC8E8A" />
    <SolidColorBrush x:Key="DownBrush" Color="#6EAA8A" />
    <SolidColorBrush x:Key="UpBackgroundBrush" Color="#1ACC8E8A" />
    <SolidColorBrush x:Key="DownBackgroundBrush" Color="#1A6EAA8A" />
    <!-- Health/status colours are neutral so they never read as "up" or "down". State is also shown by an icon and a word. -->
    <SolidColorBrush x:Key="HealthyBrush" Color="#7EA6C0" />
    <SolidColorBrush x:Key="DegradedBrush" Color="#C4A46A" />
    <SolidColorBrush x:Key="DownStateBrush" Color="#9A958C" />
    <SolidColorBrush x:Key="UnknownBrush" Color="#9A958C" />
    <SolidColorBrush x:Key="StaleBadgeBrush" Color="#C4A46A" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#1A1816" />
    <SolidColorBrush x:Key="RowHighlightBrush" Color="#35322E" />
    <SolidColorBrush x:Key="ItmBrush" Color="#22C4B3D4" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1F1D1B" />
    <SolidColorBrush x:Key="ErrorBarBrush" Color="#3A2A28" />
    <SolidColorBrush x:Key="InfoBarBrush" Color="#2C2A28" />

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DisplayFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="PageScroller" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="32,24,32,32" />
    </Style>
</ResourceDictionary>
