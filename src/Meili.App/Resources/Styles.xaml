<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:svc="clr-namespace:Meili.App.Services">
    <svc:InverseBoolConverter x:Key="InverseBool" />
    <svc:BoolToVisConverter x:Key="BoolToVis" />
    <svc:BoolToVisConverter x:Key="InverseBoolToVis" Invert="True" />
    <svc:NonEmptyToVisConverter x:Key="NonEmptyToVis" />
    <!-- Typography: nothing in the app is smaller than 12px. -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="NumberFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SubtitleFontSize">16</sys:Double>
    <sys:Double x:Key="TitleFontSize">20</sys:Double>
    <sys:Double x:Key="DisplayFontSize">28</sys:Double>

    <SolidColorBrush x:Key="UpBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="DownBrush" Color="#22A06B" />
    <SolidColorBrush x:Key="UpBackgroundBrush" Color="#1AE5484D" />
    <SolidColorBrush x:Key="DownBackgroundBrush" Color="#1A22A06B" />
    <!-- E1: health/status colours are neutral (blue / amber / slate / grey) so they never read as "up" or "down",
         whichever up/down colour convention is active. State is also shown by an icon and a word. -->
    <SolidColorBrush x:Key="HealthyBrush" Color="#3B82D6" />
    <SolidColorBrush x:Key="DegradedBrush" Color="#B07408" />
    <SolidColorBrush x:Key="DownStateBrush" Color="#7A8594" />
    <SolidColorBrush x:Key="UnknownBrush" Color="#8A8A8A" />
    <!-- E4: fill of small warning tags (stale quote) behind #1A1A1A text; ThemeService re-tones the brushes above per theme. -->
    <SolidColorBrush x:Key="StaleBadgeBrush" Color="#D99A1E" />
    <!-- E4: ATM / flashing row fill; readable with the theme's primary text (the accent fill was not). -->
    <SolidColorBrush x:Key="RowHighlightBrush" Color="#3E2F48" />

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DisplayFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="PageScroller" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="32,24,32,32" />
    </Style>
</ResourceDictionary>
