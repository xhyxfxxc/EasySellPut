<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Meili.App</RootNamespace>
    <!-- B4: neutral file name; shown as "Original filename" in Explorer and as the process name in Task Manager. -->
    <AssemblyName>MeiliTerminal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- B3: library XML docs (named after internal assemblies) are not part of the product. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ScottPlot.WPF" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meili.Core\Meili.Core.csproj" />
    <ProjectReference Include="..\Meili.Data\Meili.Data.csproj" />
    <ProjectReference Include="..\Meili.Analytics\Meili.Analytics.csproj" />
    <ProjectReference Include="..\Meili.Shared\Meili.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-64.png" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Meili.Shared.Services" />
    <Using Include="Meili.Shared.ViewModels" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meili.App.Tests" />
  </ItemGroup>
</Project>
