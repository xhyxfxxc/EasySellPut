<Page x:Class="Meili.App.Views.Pages.AlertsPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Meili.App.Views.Controls"
      xmlns:vm="clr-namespace:Meili.App.ViewModels">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="32,24,32,12">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Alerts}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Al_Desc}" Margin="0,0,0,16" />

            <!-- F10: monitoring interrupted -->
            <ui:InfoBar Title="{DynamicResource Al_MonitorDownTitle}" Message="{Binding MonitorText}"
                        IsOpen="{Binding MonitorDown}" IsClosable="False" Severity="Error" Margin="0,0,0,12"
                        AutomationProperties.AutomationId="AlertsMonitorDown" />

            <ui:Card Padding="16,16,16,12">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,10" MinWidth="180">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Al_Symbol}" Margin="0,0,0,4" />
                        <controls:SymbolBox x:Name="SymbolInput" AutomationProperties.AutomationId="AlertsSymbol" MinWidth="180"
                          Text="{Binding SymbolText}" WatchSymbols="{Binding WatchSymbols}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,10" MinWidth="220">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Al_Kind}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding KindOptions}"
                                  SelectedItem="{Binding SelectedKind}"
                                  DisplayMemberPath="Title"
                                  FontSize="14" MinHeight="32" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,10" MinWidth="140">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Al_Threshold}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding ThresholdHint}"
                                    FontSize="14" Padding="10,6,10,6" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,10" MinWidth="140">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Al_Repeat}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding RepeatOptions}"
                                  SelectedItem="{Binding SelectedRepeat}"
                                  DisplayMemberPath="Title"
                                  FontSize="14" MinHeight="32" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,10" MinWidth="120">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Al_Cooldown}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding CooldownText, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14" Padding="10,6,10,6" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,10" MinWidth="180">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Al_Note}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14" Padding="10,6,10,6" />
                    </StackPanel>
                    <StackPanel Margin="0,8,16,10" VerticalAlignment="Bottom">
                        <CheckBox Content="{DynamicResource Al_Extended}"
                                  IsChecked="{Binding IncludeExtendedHours}" IsEnabled="{Binding IsQuoteKind}"
                                  FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,10" VerticalAlignment="Bottom">
                        <ui:Button Appearance="Primary" Padding="16,6" Margin="0,0,8,0"
                                   Command="{Binding AddCommand}" Content="{DynamicResource Al_Add}" FontSize="14" />
                        <ui:Button Appearance="Secondary" Padding="16,6" Margin="0,0,8,0"
                                   Command="{Binding SaveCommand}" IsEnabled="{Binding HasSelection}"
                                   Content="{DynamicResource Al_Save}" FontSize="14" />
                        <ui:Button Appearance="Secondary" Padding="16,6"
                                   Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}"
                                   Content="{DynamicResource Al_Delete}" FontSize="14" />
                    </StackPanel>
                </WrapPanel>
            </ui:Card>

            <DockPanel Margin="0,10,0,0" LastChildFill="True">
                <!-- F3: alerts ignore quotes older than this -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Al_MaxDelay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding MaxDelayChoices}" SelectedItem="{Binding MaxDelayMinutes}" FontSize="14" MinWidth="80"
                              AutomationProperties.AutomationId="AlertsMaxDelay" />
                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Al_Minutes}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding StaleNote}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Visibility="{Binding HasStaleNote, Converter={StaticResource BoolToVis}}" />
            <!-- B1: latest IV readings for IV alerts -->
            <TextBlock Style="{StaticResource Caption}" Text="{Binding IvNote}" Margin="0,6,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="AlertsIvNote"
                       Visibility="{Binding HasIvNote, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Grid Margin="32,0,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0.55*" MinHeight="140" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                           Text="{DynamicResource Al_Title}" Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}"
                           Text="{DynamicResource Al_Empty}" Margin="0,12,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ListView x:Name="AlertList" ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow}"
                          FontSize="14"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          Background="Transparent"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource Al_ColEnabled}" Width="72">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:AlertRowViewModel}">
                                        <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource Al_ColSymbol}" DisplayMemberBinding="{Binding Symbol}" Width="90" />
                            <GridViewColumn Header="{DynamicResource Al_ColCondition}" DisplayMemberBinding="{Binding ConditionText}" Width="180" />
                            <GridViewColumn Header="{DynamicResource Al_ColThreshold}" DisplayMemberBinding="{Binding ThresholdText}" Width="100" />
                            <GridViewColumn Header="{DynamicResource Al_ColRepeat}" DisplayMemberBinding="{Binding RepeatText}" Width="100" />
                            <GridViewColumn Header="{DynamicResource Al_ColLast}" DisplayMemberBinding="{Binding LastFiredText}" Width="180" />
                            <GridViewColumn Header="{DynamicResource Al_Note}" DisplayMemberBinding="{Binding Note}" Width="160" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,16,0,8">
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6"
                           Command="{Binding ClearHistoryCommand}"
                           Content="{DynamicResource Al_ClearHistory}" FontSize="14"
                           IsEnabled="{Binding HistoryEmpty, Converter={StaticResource InverseBool}}" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Al_History}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}"
                           Text="{DynamicResource Al_HistoryEmpty}"
                           Visibility="{Binding HistoryEmpty, Converter={StaticResource BoolToVis}}" />
                <ListView ItemsSource="{Binding History}"
                          FontSize="14"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          Background="Transparent"
                          Visibility="{Binding HistoryEmpty, Converter={StaticResource InverseBoolToVis}}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource Al_ColTime}" DisplayMemberBinding="{Binding TimeText}" Width="180" />
                            <GridViewColumn Header="{DynamicResource Al_ColSymbol}" DisplayMemberBinding="{Binding Symbol}" Width="90" />
                            <GridViewColumn Header="{DynamicResource Al_ColCondition}" DisplayMemberBinding="{Binding ConditionText}" Width="240" />
                            <GridViewColumn Header="{DynamicResource Al_ColValue}" DisplayMemberBinding="{Binding ValueText}" Width="110" />
                            <GridViewColumn Header="{DynamicResource Al_ColSource}" DisplayMemberBinding="{Binding SourceText}" Width="110" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Page>