<Page x:Class="Meili.App.Views.Pages.SettingsPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="1000">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Settings}" />

            <!-- Appearance -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_Appearance}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_Language}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_LanguageDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="200" SelectedIndex="{Binding LanguageIndex}">
                    <ComboBoxItem Content="简体中文" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_Theme}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_ThemeDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="200" SelectedIndex="{Binding ThemeIndex}">
                    <ComboBoxItem Content="{DynamicResource Set_ThemeSystem}" />
                    <ComboBoxItem Content="{DynamicResource Set_ThemeLight}" />
                    <ComboBoxItem Content="{DynamicResource Set_ThemeDark}" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSort24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_UpDown}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_UpDownDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="200" SelectedIndex="{Binding UpDownIndex}">
                    <ComboBoxItem Content="{DynamicResource Set_RedUp}" />
                    <ComboBoxItem Content="{DynamicResource Set_GreenUp}" />
                </ComboBox>
            </ui:CardControl>

            <!-- Network -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_Network}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_ProxyMode}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_ProxyModeDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="240" SelectedIndex="{Binding ProxyModeIndex}">
                    <ComboBoxItem Content="{DynamicResource Set_ProxyAuto}" />
                    <ComboBoxItem Content="{DynamicResource Set_ProxySystem}" />
                    <ComboBoxItem Content="{DynamicResource Set_ProxyManual}" />
                    <ComboBoxItem Content="{DynamicResource Set_ProxyDirect}" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Router24}" IsEnabled="{Binding IsManualProxy}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_ManualProxy}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_ManualProxyDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:TextBox MinWidth="260" PlaceholderText="http://127.0.0.1:7890" Text="{Binding ManualProxy, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_ProxyEffective}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding EffectiveProxy}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Appearance="Primary" Content="{DynamicResource Set_ProxyApply}" Command="{Binding ApplyProxyCommand}" MinWidth="140" />
            </ui:CardControl>

            <!-- Close button (D4) -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Dismiss24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_CloseAction}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_CloseActionDesc}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="220" SelectedIndex="{Binding CloseActionIndex}" AutomationProperties.AutomationId="SettingsCloseAction">
                    <ComboBoxItem Content="{DynamicResource Set_CloseAsk}" />
                    <ComboBoxItem Content="{DynamicResource Close_ToTray}" />
                    <ComboBoxItem Content="{DynamicResource Close_Exit}" />
                </ComboBox>
            </ui:CardControl>

            <!-- Keyboard (D2) -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_Shortcuts}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Keyboard12324}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_ShortcutsTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_ShortcutsDesc}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Pricing (F5) -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_Pricing}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DataTrending24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_RateMode}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_RateModeDesc}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="240" SelectedIndex="{Binding RateModeIndex}" AutomationProperties.AutomationId="SettingsRateMode">
                    <ComboBoxItem Content="{DynamicResource Set_RateTreasury}" />
                    <ComboBoxItem Content="{DynamicResource Set_RateFixedItem}" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon NumberSymbol24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_FixedRate}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_FixedRateDesc}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding FixedRateError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:TextBox MinWidth="120" Text="{Binding FixedRateText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SettingsFixedRate" />
            </ui:CardControl>

            <!-- Storage -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_Storage}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_DataDir}" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding DataDirectory}" Margin="0,2,0,2" />
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_DataDirDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{DynamicResource Set_OpenFolder}" Command="{Binding OpenDataFolderCommand}" MinWidth="120" />
            </ui:CardControl>

            <!-- About -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_About}" />
            <ui:Card Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Image Source="pack://application:,,,/Assets/app-64.png" Width="40" Height="40" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{DynamicResource App_Title}" />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{DynamicResource Set_Company}" />
                                <Run Text="  ·  " />
                                <Run Text="{DynamicResource Set_Version}" />
                                <Run Text=" " />
                                <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Set_AboutDesc}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
