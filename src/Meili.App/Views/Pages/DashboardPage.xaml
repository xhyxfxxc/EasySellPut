<Page x:Class="Meili.App.Views.Pages.DashboardPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="1200">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Dashboard}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource App_Subtitle}" Margin="0,0,0,16" />

            <!-- Hero -->
            <ui:Card Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/app-64.png" Width="56" Height="56" Margin="0,0,20,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="20" Text="{DynamicResource Dash_Welcome}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" Text="{DynamicResource Dash_WelcomeBody}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- D7: getting started (network/proxy, watchlist, options) until dismissed -->
            <ui:Card Padding="20" Margin="0,12,0,0" Visibility="{Binding ShowGuide, Converter={StaticResource BoolToVis}}"
                     AutomationProperties.AutomationId="DashGuide">
                <StackPanel>
                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource Dash_GuideTitle}" />
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="10,4" Command="{Binding DismissGuideCommand}" Content="{DynamicResource Dash_GuideDismiss}" />
                </DockPanel>
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,16,0" AutomationProperties.AutomationId="GuideNetwork">
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{DynamicResource Dash_Guide1Title}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,8" TextWrapping="Wrap" Text="{Binding GuideNetworkText}" />
                        <WrapPanel>
                            <ui:Button Appearance="Secondary" Padding="10,4" Margin="0,0,8,4" Command="{Binding RedetectProxyCommand}" Content="{DynamicResource Dash_Redetect}" />
                            <ui:Button Appearance="Secondary" Padding="10,4" Margin="0,0,8,4" Command="{Binding OpenDataSourcesCommand}" Content="{DynamicResource Dash_OpenSources}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0" AutomationProperties.AutomationId="GuideWatchlist">
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{DynamicResource Dash_Guide2Title}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,8" TextWrapping="Wrap" Text="{DynamicResource Dash_Guide2Body}" />
                        <WrapPanel>
                            <ui:Button Appearance="Secondary" Padding="10,4" Margin="0,0,8,4" Command="{Binding OpenWatchlistCommand}" Content="{DynamicResource Dash_Guide2Btn}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0" AutomationProperties.AutomationId="GuideOptions">
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{DynamicResource Dash_Guide3Title}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,8" TextWrapping="Wrap" Text="{DynamicResource Dash_Guide3Body}" />
                        <WrapPanel>
                            <ui:Button Appearance="Secondary" Padding="10,4" Margin="0,0,8,4" Command="{Binding OpenOptionsCommand}" Content="{DynamicResource Dash_Guide3Btn}" />
                        </WrapPanel>
                    </StackPanel>
                </UniformGrid>
                </StackPanel>
            </ui:Card>

            <!-- Market overview (quotes via failover) -->
            <DockPanel Margin="0,24,0,8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource Dash_Market}" />
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Command="{Binding RefreshCommand}" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Dash_Refresh}" />
                    </StackPanel>
                </ui:Button>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding StatusText}" />
            </DockPanel>
            <!-- D8: every source failed — prices below are the last ones received -->
            <ui:InfoBar Title="{DynamicResource Dash_AllFailedTitle}" Message="{Binding FailureBody}"
                        IsOpen="{Binding AllSourcesFailed}" IsClosable="False" Severity="Error" Margin="0,0,0,12"
                        AutomationProperties.AutomationId="DashAllFailed">
                <WrapPanel>
                    <ui:Button Appearance="Secondary" Margin="0,0,8,0" Command="{Binding RedetectProxyCommand}" Content="{DynamicResource Dash_Redetect}" Padding="10,4"
                               Visibility="{Binding ProxyMissing, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Appearance="Secondary" Margin="0,0,8,0" Command="{Binding OpenSettingsCommand}" Content="{DynamicResource Dash_OpenSettings}" Padding="10,4"
                               Visibility="{Binding ProxyMissing, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Appearance="Secondary" Command="{Binding OpenDataSourcesCommand}" Content="{DynamicResource Dash_OpenSources}" Padding="10,4" />
                </WrapPanel>
            </ui:InfoBar>
            <ItemsControl ItemsSource="{Binding Quotes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,8,8" Padding="18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Symbol}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            ToolTip="{Binding TimingTip}">
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SourceText}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,8" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding PriceText}" FontFamily="{StaticResource NumberFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="4" Padding="8,2" Background="{Binding ChangeBackground}">
                                        <TextBlock Text="{Binding ChangeText}" FontFamily="{StaticResource NumberFont}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ChangeBrush}" />
                                    </Border>
                                    <Border Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="4" Padding="6,1" Background="{DynamicResource StaleBadgeBrush}"
                                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}" ToolTip="{Binding StaleTip}"
                                            AutomationProperties.AutomationId="StaleBadge">
                                        <TextBlock Text="{DynamicResource Quote_Stale}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BadgeTextBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ExtText}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding AsOfText}" ToolTip="{Binding TimingTip}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
