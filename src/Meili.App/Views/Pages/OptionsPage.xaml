<Page x:Class="Meili.App.Views.Pages.OptionsPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      AutomationProperties.AutomationId="OptionsPageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Meili.App.Views.Controls"
      xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Page.Resources>
        <Style x:Key="RangeChip" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SideCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding StrikeText}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAtm}" Value="True">
                    <Setter Property="BorderThickness" Value="0,0,0,0" />
                    <Setter Property="Background" Value="{DynamicResource RowHighlightBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="32,20,32,8">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Op_Title}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Op_Desc}" Margin="0,0,0,12" />

            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding ExportCommand}" ToolTip="{DynamicResource Op_Export}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Op_Export}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Op_Refresh}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="14,6" Margin="8,0,0,0"
                           Command="{Binding LoadFromBoxCommand}" Content="{DynamicResource Op_Load}" />
                <ComboBox x:Name="ExpirationBox" AutomationProperties.AutomationId="OptionsExpiration" DockPanel.Dock="Right" MinWidth="220" FontSize="14" Margin="8,0,0,0"
                          ItemsSource="{Binding Expirations}"
                          SelectedItem="{Binding SelectedExpiration}"
                          DisplayMemberPath="Label" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="12,0,0,0" Text="{DynamicResource Op_Expiration}" />
                <controls:SymbolBox x:Name="SymbolInput" AutomationProperties.AutomationId="OptionsSymbol" MinWidth="200"
                          Text="{Binding SymbolText}" WatchSymbols="{Binding WatchSymbols}" CommitCommand="{Binding LoadFromBoxCommand}" />
            </DockPanel>

            <!-- F8: chain underlying (in sync with options) + latest stock price for comparison; wraps on narrow windows -->
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding Headline}" VerticalAlignment="Center" Margin="0,2,0,2" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding LivePriceText}" VerticalAlignment="Center" Margin="12,2,0,2"
                           ToolTip="{DynamicResource Op_LivePriceTip}" AutomationProperties.AutomationId="LivePrice" />
                <Border Margin="12,2,0,2" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Visibility="{Binding HasDelay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DelayText}" />
                </Border>
                <!-- F5: pricing model and risk-free rate used for local IV / Greeks -->
                <Border Margin="8,2,0,2" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" ToolTip="{DynamicResource Px_ModelTip}">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ModelText}" />
                </Border>
                <!-- B6: IV Rank from the IV history recorded on this computer -->
                <Border Margin="8,2,0,2" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" ToolTip="{Binding IvRankTip}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding IvRankText, Converter={StaticResource NonEmptyToVis}}">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding IvRankText}" AutomationProperties.AutomationId="OptionsIvRank" />
                </Border>
            </WrapPanel>

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" Text="{DynamicResource Op_Range}" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource Op_Range5}" Tag="Near5" Click="OnWindowClick" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource Op_Range10}" Tag="Near10" Click="OnWindowClick" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource Op_Range20}" Tag="Near20" Click="OnWindowClick" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource Op_RangeAll}" Tag="All" Click="OnWindowClick" />
            </WrapPanel>

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" Text="{DynamicResource Op_Columns}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_Volume}" IsChecked="{Binding ShowVolume}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_OI}" IsChecked="{Binding ShowOi}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_OiChange}" IsChecked="{Binding ShowOiChange}" ToolTip="{DynamicResource Op_OiChangeTip}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_IV}" IsChecked="{Binding ShowIv}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_Delta}" IsChecked="{Binding ShowDelta}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_Gamma}" IsChecked="{Binding ShowGamma}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_Theta}" IsChecked="{Binding ShowTheta}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_Vega}" IsChecked="{Binding ShowVega}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_SpreadPct}" IsChecked="{Binding ShowSpread}" ToolTip="{DynamicResource Op_SpreadTip}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_Distance}" IsChecked="{Binding ShowDistance}" ToolTip="{DynamicResource Op_DistanceTip}" />
                <CheckBox Style="{StaticResource ColCheck}" Margin="12,0,0,0" Content="{DynamicResource Op_Compact}" IsChecked="{Binding CompactColumns}" ToolTip="{DynamicResource Op_CompactTip}" AutomationProperties.AutomationId="OptionsCompact" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_Smile}" IsChecked="{Binding ShowSmile}" />
                <CheckBox Style="{StaticResource ColCheck}" Content="{DynamicResource Op_Term}" IsChecked="{Binding ShowTerm}" ToolTip="{DynamicResource Op_TermTip}"
                          IsEnabled="{Binding ShowSmile}" AutomationProperties.AutomationId="OptionsTerm" />
            </WrapPanel>

            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                <ui:ProgressRing DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding LocalNote}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <scottplot:WpfPlot x:Name="SmilePlot" DockPanel.Dock="Bottom" Height="150" Margin="16,0,16,12"
                           Visibility="{Binding ShowSmile, Converter={StaticResource BoolToVis}}" />

        <Grid Margin="16,0,16,16">
            <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="{DynamicResource Op_Empty}"
                       Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}" />
            <ListView x:Name="ChainList"
                      Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="OptionsChain"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      BorderThickness="0"
                      Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{DynamicResource Op_BuildStrategy}">
                            <MenuItem Header="{DynamicResource Op_SeedLongCall}" Command="{Binding BuildStrategyCommand}" CommandParameter="LC" />
                            <MenuItem Header="{DynamicResource Op_SeedShortCall}" Command="{Binding BuildStrategyCommand}" CommandParameter="SC" />
                            <MenuItem Header="{DynamicResource Op_SeedLongPut}" Command="{Binding BuildStrategyCommand}" CommandParameter="LP" />
                            <MenuItem Header="{DynamicResource Op_SeedShortPut}" Command="{Binding BuildStrategyCommand}" CommandParameter="SP" />
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView x:Name="ChainView" AllowsColumnReorder="False">
                        <!-- Call side (filled in code so column show/hide stays in sync) -->
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Page>