<Page x:Class="Meili.App.Views.Pages.StrategyPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      AutomationProperties.AutomationId="StrategyPageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Meili.App.Views.Controls"
      xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Page.Resources>
        <Style x:Key="RangeChip" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="MinRowHeight" Value="32" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,8" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- E4: the default (inactive) selection brush is near-white, which hid the selected leg's white text in dark mode. -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" MinHeight="180" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="HeaderPanel" Grid.Row="0" Margin="32,16,32,4">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource St_Title}" />
            <Border Margin="0,8,0,8" Padding="12,8" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding ShowHint, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="StrategyHint">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="10,4" Margin="12,0,0,0"
                               Command="{Binding DismissHintCommand}" Content="{DynamicResource St_HintDismiss}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource St_Hint}" TextWrapping="Wrap" FontSize="14" />
                </DockPanel>
            </Border>
            <!-- Toolbar: symbol, expiration, template, quantity, refresh; saved strategies in an overflow. -->
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource St_Refresh}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                    <ui:Button x:Name="SavedButton" Appearance="Secondary" Padding="12,6" Click="OnSavedClick"
                               Content="{DynamicResource St_SavedMenu}" />
                    <Popup x:Name="SavedPopup" PlacementTarget="{Binding ElementName=SavedButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12" MinWidth="320">
                            <StackPanel>
                                <ComboBox Margin="0,0,0,8" FontSize="14" AutomationProperties.AutomationId="SavedStrategies"
                                          ItemsSource="{Binding Saved}" SelectedItem="{Binding SelectedSaved}" DisplayMemberPath="Name" />
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="10,6" Margin="8,0,0,0"
                                               Command="{Binding DeleteSavedCommand}" Content="{DynamicResource St_DeleteSaved}" />
                                    <ui:Button Appearance="Secondary" Padding="10,6" Command="{Binding LoadSavedCommand}"
                                               Content="{DynamicResource St_LoadSaved}" />
                                </DockPanel>
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="12,6" Margin="8,0,0,0"
                                               Command="{Binding SaveStrategyCommand}" Content="{DynamicResource St_Save}" />
                                    <ui:TextBox FontSize="14" PlaceholderText="{DynamicResource St_SaveName}"
                                                Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <ui:NumberBox DockPanel.Dock="Right" Value="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="1000"
                              SpinButtonPlacementMode="Compact" FontSize="14" Width="90" Margin="8,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" Text="{DynamicResource St_Quantity}" />
                <ComboBox DockPanel.Dock="Right" MinWidth="180" FontSize="14" Margin="8,0,0,0"
                          ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Label" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" Text="{DynamicResource St_Preset}" />
                <ComboBox DockPanel.Dock="Right" MinWidth="180" FontSize="14" Margin="8,0,0,0"
                          Visibility="{Binding NeedsFarExpiration, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding FarExpirations}" SelectedItem="{Binding SelectedFarExpiration}" DisplayMemberPath="Label" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding NeedsFarExpiration, Converter={StaticResource BoolToVis}}"
                           Text="{DynamicResource St_FarExpiration}" />
                <Border DockPanel.Dock="Right" Margin="8,0,0,0" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource DownBrush}" BorderThickness="1"
                        Visibility="{Binding IsExpirationToday, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="ExpirationToday">
                    <TextBlock FontSize="12" Foreground="{DynamicResource DownBrush}" Text="{DynamicResource St_ExpiresToday}" />
                </Border>
                <ComboBox x:Name="ExpirationBox" AutomationProperties.AutomationId="StrategyExpiration"
                          DockPanel.Dock="Right" MinWidth="200" FontSize="14" Margin="8,0,0,0"
                          ItemsSource="{Binding Expirations}" SelectedItem="{Binding SelectedExpiration}" DisplayMemberPath="Label" />
                <controls:SymbolBox x:Name="SymbolInput" AutomationProperties.AutomationId="StrategySymbol" MinWidth="160"
                                    Text="{Binding SymbolText}" WatchSymbols="{Binding WatchSymbols}" CommitCommand="{Binding LoadFromBoxCommand}" />
            </DockPanel>
            <!-- Thin status line: quote, delay once, model, source. -->
            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                <ui:ProgressRing DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{Binding Headline}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{Binding LivePriceText}" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="{DynamicResource Op_LivePriceTip}" AutomationProperties.AutomationId="LivePrice" />
                <Border DockPanel.Dock="Left" Margin="0,0,8,0" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Visibility="{Binding HasDelay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DelayText}" />
                </Border>
                <Border DockPanel.Dock="Left" Margin="0,0,8,0" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" ToolTip="{DynamicResource Px_ModelTip}">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ModelText}" />
                </Border>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{Binding SourceText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding LocalNote}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <ScrollViewer x:Name="MidScroll" Grid.Row="1" Margin="32,0,32,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Left: summary + compact legs -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{DynamicResource St_Summary}" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" FontSize="14" Text="{Binding StrategySummaryText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ui:Button Appearance="Secondary" Padding="10,6" Margin="0,0,8,0" Command="{Binding AddCallCommand}" Content="{DynamicResource St_AddCall}" />
                        <ui:Button Appearance="Secondary" Padding="10,6" Margin="0,0,8,0" Command="{Binding AddPutCommand}" Content="{DynamicResource St_AddPut}" />
                        <ui:Button Appearance="Secondary" Padding="10,6" Margin="0,0,8,0" Command="{Binding AddStockCommand}" Content="{DynamicResource St_AddStock}" />
                        <ui:Button Appearance="Secondary" Padding="10,6" Command="{Binding RemoveLegCommand}" Content="{DynamicResource St_RemoveLeg}" />
                    </WrapPanel>
                    <DataGrid x:Name="LegsGrid" AutomationProperties.AutomationId="StrategyLegs" VerticalAlignment="Top"
                              ItemsSource="{Binding Legs}" SelectedItem="{Binding SelectedLeg}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource St_Type}" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="14" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox FontSize="14"
                                                  ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource St_Side}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SideLabel}" FontSize="14" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox FontSize="14"
                                                  ItemsSource="{Binding DataContext.SideChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedValue="{Binding Side, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource St_Strike}" Binding="{Binding StrikeText, UpdateSourceTrigger=LostFocus}" Width="90" />
                            <DataGridTextColumn Header="{DynamicResource St_Premium}" Binding="{Binding PremiumText, UpdateSourceTrigger=LostFocus}" Width="90" />
                            <DataGridTextColumn Header="{DynamicResource St_IV}" Binding="{Binding IvText, UpdateSourceTrigger=LostFocus}" Width="70" />
                            <DataGridTextColumn Header="{DynamicResource St_Qty}" Binding="{Binding QtyText, UpdateSourceTrigger=LostFocus}" Width="70" />
                            <DataGridTextColumn Header="{DynamicResource St_Expiry}" Binding="{Binding ExpiryText, UpdateSourceTrigger=LostFocus}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <!-- Right: hierarchical result cards -->
                <StackPanel Grid.Column="2">
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_MaxProfit}" />
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="20" Foreground="{DynamicResource UpBrush}" Text="{Binding MaxProfitText}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding MaxProfitConditionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_MaxLoss}" />
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="20" Foreground="{DynamicResource DownBrush}" Text="{Binding MaxLossText}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding MaxLossConditionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_Breakeven}" />
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding BreakevenText}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding BreakevenConditionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,12,0" ToolTip="{DynamicResource St_PopTip}" AutomationProperties.AutomationId="Pop">
                            <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_Pop}" />
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding PopText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_Capital}" />
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding CapitalText}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CapitalDetailText}" TextWrapping="Wrap"
                                       Visibility="{Binding HasStockCapital, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Margin="0,0,0,4" ToolTip="{Binding MarginTip}" AutomationProperties.AutomationId="Margin">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_Margin}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="14" Text="{Binding MarginText}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding RewardText}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding GreeksText}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Chart takes at least half of the remaining height. -->
        <DockPanel Grid.Row="2" Margin="16,0,16,12">
            <WrapPanel Margin="16,0,16,6" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" Text="{DynamicResource St_Horizon}" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_TnNow}" Tag="0" Click="OnHorizonClick" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_Tn7}" Tag="7" Click="OnHorizonClick" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_Tn14}" Tag="14" Click="OnHorizonClick" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_Tn30}" Tag="30" Click="OnHorizonClick" />
                <StackPanel Orientation="Horizontal" Margin="16,0,16,0">
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource St_WhatIf}" />
                    <ui:TextBox Width="90" FontSize="14" Text="{Binding WhatIfPriceText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding WhatIfPercentText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource St_TickDensity}" />
                    <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_TickSparse}" Tag="tick:0" Click="OnTickDensityClick" />
                    <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_TickMedium}" Tag="tick:1" Click="OnTickDensityClick" />
                    <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_TickDense}" Tag="tick:2" Click="OnTickDensityClick" />
                </StackPanel>
            </WrapPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Text="{DynamicResource St_NoLegs}"
                               Visibility="{Binding HasCurve, Converter={StaticResource InverseBoolToVis}}" />
                    <scottplot:WpfPlot x:Name="PayoffPlot" AutomationProperties.AutomationId="StrategyChart"
                                       MouseLeftButtonUp="OnChartClick"
                                       Visibility="{Binding HasCurve, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <controls:PriceRuler x:Name="Ruler" Grid.Column="1" Margin="4,8,0,8"
                                     AutomationProperties.AutomationId="StrategyRuler"
                                     AutomationProperties.Name="{DynamicResource St_Ruler}"
                                     Visibility="{Binding HasWhatIf, Converter={StaticResource BoolToVis}}" />
                <ScrollViewer Grid.Column="2" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto"
                              AutomationProperties.AutomationId="StrategyWhatIf"
                              Visibility="{Binding HasWhatIf, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_WhatIfValue}" />
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding WhatIfValueText}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{DynamicResource St_WhatIfPnl}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding WhatIfPnlText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WhatIfPnlIsProfit}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource UpBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WhatIfPnlIsLoss}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DownBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding WhatIfLegs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Label}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{Binding PriceText}" />
                                            <TextBlock FontSize="14" HorizontalAlignment="Right" Text="{Binding PnlText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProfit}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource UpBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DownBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="14" Text="{Binding Reason}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Page>