<Page x:Class="Meili.App.Views.Pages.DataSourcesPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="1200">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Ds_Title}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Ds_Desc}" Margin="0,0,0,16" />

            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding SummaryText}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding NetworkText}" Margin="0,2,0,0" />
                </StackPanel>
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="14,7" Command="{Binding TestAllCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Pulse24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding TestButtonText}" />
                    </StackPanel>
                </ui:Button>
                <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                 Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,8,8" Padding="18,14" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding StateIcon, Converter={StaticResource HealthIcon}}" Filled="True" FontSize="16" Foreground="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border DockPanel.Dock="Left" Margin="10,0,0,0" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding RegionText}" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                            BorderThickness="1" BorderBrush="{Binding StateBrush}">
                                        <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StateBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,12" Text="{Binding CapabilitiesText}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ds_Latency}" />
                                        <TextBlock Style="{StaticResource CardTitle}" FontFamily="{StaticResource NumberFont}" Text="{Binding LatencyText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ds_Success}" />
                                        <TextBlock Style="{StaticResource CardTitle}" FontFamily="{StaticResource NumberFont}" Text="{Binding SuccessText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ds_Failures}" />
                                        <TextBlock Style="{StaticResource CardTitle}" FontFamily="{StaticResource NumberFont}" Text="{Binding FailureText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ds_LastUsed}" />
                                        <TextBlock Style="{StaticResource CardTitle}" FontFamily="{StaticResource NumberFont}" Text="{Binding LastUsedText}" />
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,12,0,0" Padding="10,6" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource DegradedBrush}"
                                        Visibility="{Binding IsCircuitOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource DegradedBrush}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding CircuitText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,12,0,0" Padding="10,6" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" Text="{DynamicResource Ds_LastError}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LastErrorText}" TextTrimming="CharacterEllipsis" MaxHeight="54"
                                                   ToolTip="{Binding LastErrorText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Ds_Failover}" />
            <ui:Card Padding="18,10">
                <ItemsControl ItemsSource="{Binding Failover}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Capability}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Chain}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>