<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Meili.Mac.App"
             RequestedThemeVariant="Default"
             Name="美丽稻谷终端">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Typography: nothing in the app is smaller than 12px. PingFang SC carries the Chinese glyphs. -->
            <FontFamily x:Key="AppFont">.AppleSystemUIFont, PingFang SC</FontFamily>
            <FontFamily x:Key="NumberFont">.AppleSystemUIFont, PingFang SC</FontFamily>
            <x:Double x:Key="CaptionFontSize">12</x:Double>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="SubtitleFontSize">16</x:Double>
            <x:Double x:Key="TitleFontSize">20</x:Double>
            <x:Double x:Key="DisplayFontSize">28</x:Double>
            <!-- Same resource names as the Windows build, so page markup reads the same on both. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ErrorBarBrush" Color="#FDE7E9" />
                    <SolidColorBrush x:Key="InfoBarBrush" Color="#E8EEF8" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7A4FB8" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#4C3A3A3A" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#202020" />
                    <SolidColorBrush x:Key="ErrorBarBrush" Color="#442726" />
                    <SolidColorBrush x:Key="InfoBarBrush" Color="#2B3340" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#C9A6F2" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1A1A1A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <!-- After the resources: the styles use StaticResource sizes defined above. -->
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://MeiliMac/Styles.axaml" />
    </Application.Styles>
</Application>
