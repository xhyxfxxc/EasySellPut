<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meili.Shared.ViewModels"
             xmlns:sp="using:ScottPlot.Avalonia"
             xmlns:local="using:Meili.Mac.Views"
             x:Class="Meili.Mac.Views.ChartsPage"
             x:DataType="vm:ChartsViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="32,20,32,8">
            <TextBlock Classes="PageTitle" Text="{DynamicResource Ch_Title}" />
            <TextBlock Classes="Secondary" Text="{DynamicResource Ch_Desc}" Margin="0,0,0,12" />

            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <Button DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Command="{Binding ExportCommand}" ToolTip.Tip="{DynamicResource Ch_Export}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⤓" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Ch_Export}" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↻" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Ch_Refresh}" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Classes="accent" Padding="14,6" Margin="8,0,0,0"
                           Command="{Binding LoadFromBoxCommand}" Content="{DynamicResource Ch_Load}" />
                <controls:SymbolBox x:Name="SymbolInput" AutomationProperties.AutomationId="ChartsSymbol" MinWidth="220"
                          Text="{Binding SymbolText}" WatchSymbols="{Binding WatchSymbols}" CommitCommand="{Binding LoadFromBoxCommand}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Ranges}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="RangeChip"
                                Content="{Binding Title}"
                                Command="{Binding DataContext.SelectRangeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding Kind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Margin="0,0,0,8">
                <CheckBox Classes="IndCheck" Content="{Binding MaLabel}" IsChecked="{Binding ShowMa}" />
                <CheckBox Classes="IndCheck" Content="{Binding EmaLabel}" IsChecked="{Binding ShowEma}" />
                <CheckBox Classes="IndCheck" Content="{Binding BollLabel}" IsChecked="{Binding ShowBoll}" />
                <CheckBox Classes="IndCheck" Content="{DynamicResource Ch_Volume}" IsChecked="{Binding ShowVolume}" />
                <CheckBox Classes="IndCheck" Content="{Binding MacdLabel}" IsChecked="{Binding ShowMacd}" />
                <CheckBox Classes="IndCheck" Content="{Binding RsiLabel}" IsChecked="{Binding ShowRsi}" />
                <CheckBox Classes="IndCheck" Content="{Binding KdjLabel}" IsChecked="{Binding ShowKdj}" />
                <!-- F7: adjustment basis -->
                <Border Width="1" Height="18" Margin="4,0,12,0" VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <CheckBox Classes="IndCheck" Content="{DynamicResource Ch_AdjToggle}" IsChecked="{Binding DividendAdjusted}"
                          ToolTip.Tip="{DynamicResource Ch_AdjToggleTip}" AutomationProperties.AutomationId="ChartsDividendAdjusted" />
                <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        ToolTip.Tip="{DynamicResource Ch_AdjToggleTip}" IsVisible="{Binding AdjustText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Classes="Caption" Text="{Binding AdjustText}" />
                </Border>
            </WrapPanel>
            <!-- B5: drawing tools and a rebased comparison symbol -->
            <WrapPanel Margin="0,0,0,8">
                <Button Padding="10,5" Margin="0,0,6,0" Content="{DynamicResource Ch_DrawHLine}" ToolTip.Tip="{DynamicResource Ch_DrawHLineHint}"
                           Command="{Binding StartDrawingCommand}" CommandParameter="{x:Static cs:DrawingKind.HorizontalLine}" AutomationProperties.AutomationId="ChartsDrawHLine" />
                <Button Padding="10,5" Margin="0,0,6,0" Content="{DynamicResource Ch_DrawTrend}" ToolTip.Tip="{DynamicResource Ch_DrawTrendHint1}"
                           Command="{Binding StartDrawingCommand}" CommandParameter="{x:Static cs:DrawingKind.TrendLine}" AutomationProperties.AutomationId="ChartsDrawTrend" />
                <Button Padding="10,5" Margin="0,0,16,0" Content="{DynamicResource Ch_DrawClear}" Command="{Binding ClearDrawingsCommand}" />
                <TextBlock Classes="Caption" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource Ch_Compare}" />
                <TextBox Width="120" Text="{Binding CompareText}" Watermark="{DynamicResource Ch_ComparePlaceholder}"
                            FontSize="13" Margin="0,0,6,0" AutomationProperties.AutomationId="ChartsCompare">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ApplyCompareCommand}" />
                    </ui:TextBox.InputBindings>
                </TextBox>
                <Button Padding="10,5" Content="{DynamicResource Ch_CompareApply}" Command="{Binding ApplyCompareCommand}" />
                <TextBlock Classes="Caption" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding CompareStatus}" Foreground="{DynamicResource DegradedBrush}" />
            </WrapPanel>
            <!-- G3: indicator parameters (saved; the chart recomputes without reloading) -->
            <Expander Margin="0,0,0,8" Header="{DynamicResource Ch_Params}" AutomationProperties.AutomationId="ChartsIndicatorParams">
                <WrapPanel Margin="0,8,0,0">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PMa}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding MaPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" Increment="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PEma}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding EmaPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" Increment="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PBoll}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding BollPeriod, UpdateSourceTrigger=LostFocus}" Minimum="2" Maximum="250" Increment="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PBollWidth}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding BollWidth, UpdateSourceTrigger=LostFocus}" Minimum="0.5" Maximum="5" Increment="0.1" MaxDecimalPlaces="2" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PMacdFast}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding MacdFast, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" Increment="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PMacdSlow}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding MacdSlow, UpdateSourceTrigger=LostFocus}" Minimum="2" Maximum="251" Increment="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PMacdSignal}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding MacdSignal, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" Increment="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PRsi}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding RsiPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" Increment="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PKdj}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding KdjPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" Increment="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PKdjM1}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding KdjM1, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" Increment="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Classes="Caption" Text="{DynamicResource Ch_PKdjM2}" Margin="0,0,0,4" />
                        <NumericUpDown Width="116" Value="{Binding KdjM2, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" Increment="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <Button VerticalAlignment="Bottom" Margin="0,0,0,8" Padding="12,6" Content="{DynamicResource Ch_PReset}" Command="{Binding ResetIndicatorsCommand}" />
                </WrapPanel>
            </Expander>
            <TextBlock Text="{Binding AdjustWarning}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource DegradedBrush}"
                       IsVisible="{Binding AdjustWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.AutomationId="ChartsAdjustWarning" />

            <DockPanel LastChildFill="True">
                <ProgressBar IsIndeterminate="True" DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True"
                                 IsVisible="{Binding IsBusy}" />
                <TextBlock Classes="Caption" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Classes="Caption" FontFamily="{StaticResource NumberFont}"
                           Text="{Binding CrosshairText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </StackPanel>

        <Grid x:Name="PlotGrid" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PriceRow" Height="2*" />
                <RowDefinition x:Name="VolumeRow" Height="0.6*" />
                <RowDefinition x:Name="MacdRow" Height="0.7*" />
                <RowDefinition x:Name="RsiRow" Height="0.55*" />
                <RowDefinition x:Name="KdjRow" Height="0.55*" />
            </Grid.RowDefinitions>
            <scottplot:WpfPlot x:Name="PricePlot" Grid.Row="0" MinHeight="160" />
            <scottplot:WpfPlot x:Name="VolumePlot" Grid.Row="1" MinHeight="70" />
            <scottplot:WpfPlot x:Name="MacdPlot" Grid.Row="2" MinHeight="80" />
            <scottplot:WpfPlot x:Name="RsiPlot" Grid.Row="3" MinHeight="70" />
            <scottplot:WpfPlot x:Name="KdjPlot" Grid.Row="4" MinHeight="70" />
        </Grid>
    </DockPanel>
</UserControl>