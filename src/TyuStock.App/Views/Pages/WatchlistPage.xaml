<Page x:Class="TyuStock.App.Views.Pages.WatchlistPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:TyuStock.Core.Models;assembly=TyuStock.Core">
    <DockPanel>
        <DockPanel.Resources>
            <Style x:Key="GroupChip" TargetType="Button">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Resources>

        <StackPanel DockPanel.Dock="Top" Margin="32,24,32,12">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Wl_Title}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Wl_Desc}" Margin="0,0,0,16" />

            <!-- Groups -->
            <DockPanel Margin="0,0,0,12" LastChildFill="False">
                <ItemsControl ItemsSource="{Binding Groups}" DockPanel.Dock="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GroupChip}"
                                    Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding Id}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Count, StringFormat='({0})'}" FontSize="12" Margin="8,0,0,0" Opacity="0.85" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="10,6" Margin="4,0,0,0"
                           Command="{Binding RemoveGroupCommand}" IsEnabled="{Binding CanRemoveGroup}" ToolTip="{DynamicResource Wl_RemoveGroup}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Wl_RemoveGroup}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="10,6" Margin="4,0,0,0"
                           Command="{Binding BeginRenameGroupCommand}" ToolTip="{DynamicResource Wl_RenameGroup}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Edit24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Wl_RenameGroup}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="10,6"
                           Command="{Binding BeginAddGroupCommand}" ToolTip="{DynamicResource Wl_AddGroup}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Wl_AddGroup}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
            </DockPanel>

            <DockPanel Margin="0,0,0,12" LastChildFill="True"
                        Visibility="{Binding IsAddingGroup, Converter={StaticResource BoolToVis}}">
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding CancelGroupEditCommand}" Content="{DynamicResource Wl_Cancel}" />
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="12,6" Command="{Binding ConfirmGroupEditCommand}" Content="{DynamicResource Wl_Ok}" />
                <ui:TextBox Text="{Binding GroupNameDraft, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{DynamicResource Wl_GroupNameHint}" FontSize="14" />
            </DockPanel>
            <DockPanel Margin="0,0,0,12" LastChildFill="True"
                        Visibility="{Binding IsRenamingGroup, Converter={StaticResource BoolToVis}}">
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding CancelGroupEditCommand}" Content="{DynamicResource Wl_Cancel}" />
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="12,6" Command="{Binding ConfirmGroupEditCommand}" Content="{DynamicResource Wl_Ok}" />
                <ui:TextBox Text="{Binding GroupNameDraft, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{DynamicResource Wl_GroupNameHint}" FontSize="14" />
            </DockPanel>

            <!-- Search + actions -->
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                           Command="{Binding ExportCommand}" ToolTip="{DynamicResource Wl_Export}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Wl_Export}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                           Command="{Binding RefreshCommand}" ToolTip="{DynamicResource Wl_Refresh}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Wl_Refresh}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                           Command="{Binding MoveDownCommand}" ToolTip="{DynamicResource Wl_MoveDown}">
                    <ui:SymbolIcon Symbol="ArrowDown24" FontSize="16" />
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                           Command="{Binding MoveUpCommand}" ToolTip="{DynamicResource Wl_MoveUp}">
                    <ui:SymbolIcon Symbol="ArrowUp24" FontSize="16" />
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                           Command="{Binding RemoveSelectedCommand}" ToolTip="{DynamicResource Wl_Remove}">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="14,6" Margin="8,0,0,0"
                           Command="{Binding AddCommand}" Content="{DynamicResource Wl_Add}" />
                <Grid>
                    <ui:TextBox x:Name="QueryBox"
                                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{DynamicResource Wl_SymbolHint}"
                                FontSize="14"
                                KeyDown="OnQueryKeyDown" />
                    <Popup IsOpen="{Binding ShowSuggestions}" PlacementTarget="{Binding ElementName=QueryBox}"
                           Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                        <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="0,4" MinWidth="360" MaxHeight="280"
                                Margin="0,4,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="12,6"
                                           Text="{DynamicResource Wl_SearchEmpty}"
                                           Visibility="{Binding ShowSearchEmpty, Converter={StaticResource BoolToVis}}" />
                                <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}"
                                         BorderThickness="0" Background="Transparent"
                                         MouseLeftButtonUp="OnSuggestionClick" PreviewKeyDown="OnSuggestionKeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SymbolMatch}">
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <TextBlock Text="{Binding Symbol}" FontSize="14" FontWeight="SemiBold" Width="88" />
                                                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                                <TextBlock Text="{Binding Exchange}" FontSize="12" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>

            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <ui:ProgressRing DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" />
            </DockPanel>
            <!-- D8 -->
            <ui:InfoBar Title="{DynamicResource Dash_AllFailedTitle}" Message="{DynamicResource Dash_AllFailedBody}"
                        IsOpen="{Binding AllSourcesFailed}" IsClosable="False" Severity="Error" Margin="0,0,0,8"
                        AutomationProperties.AutomationId="WatchAllFailed">
                <ui:Button Appearance="Secondary" Command="{Binding OpenDataSourcesCommand}" Content="{DynamicResource Dash_OpenSources}" Padding="10,4" />
            </ui:InfoBar>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="32,24,32,0"
                   Text="{DynamicResource Wl_Empty}"
                   Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}" />

        <ListView x:Name="QuoteList"
                      Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  Margin="32,0,32,24"
                  BorderThickness="0"
                  FontSize="14"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                  MouseMove="OnListMouseMove"
                  Drop="OnListDrop"
                  MouseDoubleClick="OnListDoubleClick"
                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="8,8" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Style>
                <Style x:Key="NumHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                </Style>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="0,4" />
                    <Setter Property="FontSize" Value="14" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RowHighlightBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>
            <ListView.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{DynamicResource Wl_OpenChart}" Command="{Binding OpenChartCommand}" InputGestureText="{DynamicResource Wl_DoubleClick}" />
                    <MenuItem Header="{DynamicResource Wl_OpenOptions}" Command="{Binding OpenOptionsCommand}" />
                    <MenuItem Header="{DynamicResource Wl_OpenStrategy}" Command="{Binding OpenStrategyCommand}" />
                    <MenuItem Header="{DynamicResource Wl_OpenNews}" Command="{Binding OpenNewsCommand}" />
                    <Separator />
                    <MenuItem Header="{DynamicResource Wl_MoveUp}" Command="{Binding MoveUpCommand}" />
                    <MenuItem Header="{DynamicResource Wl_MoveDown}" Command="{Binding MoveDownCommand}" />
                    <MenuItem Header="{DynamicResource Wl_Remove}" Command="{Binding RemoveSelectedCommand}" />
                    <Separator />
                    <MenuItem Header="{DynamicResource Wl_SetAlert}" Command="{Binding SetAlertCommand}" />
                    <MenuItem Header="{DynamicResource Wl_Export}" Command="{Binding ExportCommand}" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="110">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource Wl_ColSymbol}" FontSize="12" FontWeight="SemiBold" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Symbol}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="180">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource Wl_ColName}" FontSize="12" FontWeight="SemiBold" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- E2: numeric columns are right-aligned with tabular digits -->
                    <GridViewColumn Width="100" HeaderContainerStyle="{StaticResource NumHeader}">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource Wl_ColPrice}" FontSize="12" FontWeight="SemiBold" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PriceText}" FontFamily="{StaticResource NumberFont}" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- D8: quote time + stale marker -->
                    <GridViewColumn Width="120">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource Wl_ColTime}" FontSize="12" FontWeight="SemiBold" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PriceTimeText}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding TimingTip}" />
                                    <Border Margin="6,0,0,0" VerticalAlignment="Center" CornerRadius="4" Padding="6,1" Background="{StaticResource StaleBadgeBrush}"
                                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}" ToolTip="{Binding StaleTip}"
                                            AutomationProperties.AutomationId="StaleBadge">
                                        <TextBlock Text="{DynamicResource Quote_Stale}" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="100" HeaderContainerStyle="{StaticResource NumHeader}">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource Wl_ColChange}" FontSize="12" FontWeight="SemiBold" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" Background="{Binding ChangeBackground}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ChangeText}" FontFamily="{StaticResource NumberFont}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding ChangeBrush}" />
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="100" HeaderContainerStyle="{StaticResource NumHeader}">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource Wl_ColChangePct}" FontSize="12" FontWeight="SemiBold" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" Background="{Binding ChangeBackground}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ChangePctText}" FontFamily="{StaticResource NumberFont}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding ChangeBrush}" />
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="200">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource Wl_ColExt}" FontSize="12" FontWeight="SemiBold" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExtText}" FontFamily="{StaticResource NumberFont}" FontSize="13" VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="90" HeaderContainerStyle="{StaticResource NumHeader}">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource Wl_ColVolume}" FontSize="12" FontWeight="SemiBold" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding VolumeText}" FontFamily="{StaticResource NumberFont}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="200">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource Wl_ColSource}" FontSize="12" FontWeight="SemiBold" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding TimingTip}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Page>