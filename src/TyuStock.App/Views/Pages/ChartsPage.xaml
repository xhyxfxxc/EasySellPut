<Page x:Class="TyuStock.App.Views.Pages.ChartsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Page.Resources>
        <Style x:Key="RangeChip" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IndCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="32,20,32,8">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Ch_Title}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Ch_Desc}" Margin="0,0,0,12" />

            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding ExportCommand}" ToolTip="{DynamicResource Ch_Export}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Ch_Export}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Ch_Refresh}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="14,6" Margin="8,0,0,0"
                           Command="{Binding LoadFromBoxCommand}" Content="{DynamicResource Ch_Load}" />
                <ComboBox MinWidth="220" FontSize="14" IsEditable="True" StaysOpenOnEdit="True"
                          ItemsSource="{Binding WatchSymbols}"
                          Text="{Binding SymbolText, UpdateSourceTrigger=PropertyChanged}"
                          KeyDown="OnSymbolKeyDown" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Ranges}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource RangeChip}"
                                Content="{Binding Title}"
                                Command="{Binding DataContext.SelectRangeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding Kind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Margin="0,0,0,8">
                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_MA}" IsChecked="{Binding ShowMa}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_EMA}" IsChecked="{Binding ShowEma}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_BOLL}" IsChecked="{Binding ShowBoll}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_Volume}" IsChecked="{Binding ShowVolume}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_MACD}" IsChecked="{Binding ShowMacd}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_RSI}" IsChecked="{Binding ShowRsi}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_KDJ}" IsChecked="{Binding ShowKdj}" />
            </WrapPanel>

            <DockPanel LastChildFill="True">
                <ui:ProgressRing DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Style="{StaticResource Caption}" FontFamily="{StaticResource NumberFont}"
                           Text="{Binding CrosshairText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </StackPanel>

        <Grid x:Name="PlotGrid" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PriceRow" Height="2*" />
                <RowDefinition x:Name="VolumeRow" Height="0.6*" />
                <RowDefinition x:Name="MacdRow" Height="0.7*" />
                <RowDefinition x:Name="RsiRow" Height="0.55*" />
                <RowDefinition x:Name="KdjRow" Height="0.55*" />
            </Grid.RowDefinitions>
            <scottplot:WpfPlot x:Name="PricePlot" Grid.Row="0" MinHeight="160" />
            <scottplot:WpfPlot x:Name="VolumePlot" Grid.Row="1" MinHeight="70" />
            <scottplot:WpfPlot x:Name="MacdPlot" Grid.Row="2" MinHeight="80" />
            <scottplot:WpfPlot x:Name="RsiPlot" Grid.Row="3" MinHeight="70" />
            <scottplot:WpfPlot x:Name="KdjPlot" Grid.Row="4" MinHeight="70" />
        </Grid>
    </DockPanel>
</Page>