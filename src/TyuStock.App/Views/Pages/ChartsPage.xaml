<Page x:Class="TyuStock.App.Views.Pages.ChartsPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:cs="clr-namespace:TyuStock.Core.Settings;assembly=TyuStock.Core"
      xmlns:controls="clr-namespace:TyuStock.App.Views.Controls"
      xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Page.Resources>
        <Style x:Key="RangeChip" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IndCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="32,20,32,8">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Ch_Title}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Ch_Desc}" Margin="0,0,0,12" />

            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding ExportCommand}" ToolTip="{DynamicResource Ch_Export}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Ch_Export}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Ch_Refresh}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="14,6" Margin="8,0,0,0"
                           Command="{Binding LoadFromBoxCommand}" Content="{DynamicResource Ch_Load}" />
                <controls:SymbolBox x:Name="SymbolInput" AutomationProperties.AutomationId="ChartsSymbol" MinWidth="220"
                          Text="{Binding SymbolText}" WatchSymbols="{Binding WatchSymbols}" CommitCommand="{Binding LoadFromBoxCommand}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Ranges}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource RangeChip}"
                                Content="{Binding Title}"
                                Command="{Binding DataContext.SelectRangeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding Kind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Margin="0,0,0,8">
                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding MaLabel}" IsChecked="{Binding ShowMa}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding EmaLabel}" IsChecked="{Binding ShowEma}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding BollLabel}" IsChecked="{Binding ShowBoll}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_Volume}" IsChecked="{Binding ShowVolume}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding MacdLabel}" IsChecked="{Binding ShowMacd}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding RsiLabel}" IsChecked="{Binding ShowRsi}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{Binding KdjLabel}" IsChecked="{Binding ShowKdj}" />
                <!-- F7: adjustment basis -->
                <Border Width="1" Height="18" Margin="4,0,12,0" VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <CheckBox Style="{StaticResource IndCheck}" Content="{DynamicResource Ch_AdjToggle}" IsChecked="{Binding DividendAdjusted}"
                          ToolTip="{DynamicResource Ch_AdjToggleTip}" AutomationProperties.AutomationId="ChartsDividendAdjusted" />
                <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        ToolTip="{DynamicResource Ch_AdjToggleTip}" Visibility="{Binding AdjustText, Converter={StaticResource NonEmptyToVis}}">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding AdjustText}" />
                </Border>
            </WrapPanel>
            <!-- B5: drawing tools and a rebased comparison symbol -->
            <WrapPanel Margin="0,0,0,8">
                <ui:Button Appearance="Secondary" Padding="10,5" Margin="0,0,6,0" Content="{DynamicResource Ch_DrawHLine}" ToolTip="{DynamicResource Ch_DrawHLineHint}"
                           Command="{Binding StartDrawingCommand}" CommandParameter="{x:Static cs:DrawingKind.HorizontalLine}" AutomationProperties.AutomationId="ChartsDrawHLine" />
                <ui:Button Appearance="Secondary" Padding="10,5" Margin="0,0,6,0" Content="{DynamicResource Ch_DrawTrend}" ToolTip="{DynamicResource Ch_DrawTrendHint1}"
                           Command="{Binding StartDrawingCommand}" CommandParameter="{x:Static cs:DrawingKind.TrendLine}" AutomationProperties.AutomationId="ChartsDrawTrend" />
                <ui:Button Appearance="Secondary" Padding="10,5" Margin="0,0,16,0" Content="{DynamicResource Ch_DrawClear}" Command="{Binding ClearDrawingsCommand}" />
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource Ch_Compare}" />
                <ui:TextBox Width="120" Text="{Binding CompareText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource Ch_ComparePlaceholder}"
                            FontSize="13" Margin="0,0,6,0" AutomationProperties.AutomationId="ChartsCompare">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ApplyCompareCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <ui:Button Appearance="Secondary" Padding="10,5" Content="{DynamicResource Ch_CompareApply}" Command="{Binding ApplyCompareCommand}" />
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding CompareStatus}" Foreground="{DynamicResource DegradedBrush}" />
            </WrapPanel>
            <!-- G3: indicator parameters (saved; the chart recomputes without reloading) -->
            <Expander Margin="0,0,0,8" Header="{DynamicResource Ch_Params}" AutomationProperties.AutomationId="ChartsIndicatorParams">
                <WrapPanel Margin="0,8,0,0">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMa}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding MaPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PEma}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding EmaPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PBoll}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding BollPeriod, UpdateSourceTrigger=LostFocus}" Minimum="2" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PBollWidth}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding BollWidth, UpdateSourceTrigger=LostFocus}" Minimum="0.5" Maximum="5" SmallChange="0.1" MaxDecimalPlaces="2" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMacdFast}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding MacdFast, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMacdSlow}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding MacdSlow, UpdateSourceTrigger=LostFocus}" Minimum="2" Maximum="251" SmallChange="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PMacdSignal}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding MacdSignal, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PRsi}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding RsiPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PKdj}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding KdjPeriod, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PKdjM1}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding KdjM1, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ch_PKdjM2}" Margin="0,0,0,4" />
                        <ui:NumberBox Width="116" Value="{Binding KdjM2, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="250" SmallChange="1" MaxDecimalPlaces="0" FontSize="13" />
                    </StackPanel>
                    <ui:Button VerticalAlignment="Bottom" Margin="0,0,0,8" Appearance="Secondary" Padding="12,6" Content="{DynamicResource Ch_PReset}" Command="{Binding ResetIndicatorsCommand}" />
                </WrapPanel>
            </Expander>
            <TextBlock Text="{Binding AdjustWarning}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource DegradedBrush}"
                       Visibility="{Binding AdjustWarning, Converter={StaticResource NonEmptyToVis}}" AutomationProperties.AutomationId="ChartsAdjustWarning" />

            <DockPanel LastChildFill="True">
                <ui:ProgressRing DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Style="{StaticResource Caption}" FontFamily="{StaticResource NumberFont}"
                           Text="{Binding CrosshairText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </StackPanel>

        <Grid x:Name="PlotGrid" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PriceRow" Height="2*" />
                <RowDefinition x:Name="VolumeRow" Height="0.6*" />
                <RowDefinition x:Name="MacdRow" Height="0.7*" />
                <RowDefinition x:Name="RsiRow" Height="0.55*" />
                <RowDefinition x:Name="KdjRow" Height="0.55*" />
            </Grid.RowDefinitions>
            <scottplot:WpfPlot x:Name="PricePlot" Grid.Row="0" MinHeight="160" />
            <scottplot:WpfPlot x:Name="VolumePlot" Grid.Row="1" MinHeight="70" />
            <scottplot:WpfPlot x:Name="MacdPlot" Grid.Row="2" MinHeight="80" />
            <scottplot:WpfPlot x:Name="RsiPlot" Grid.Row="3" MinHeight="70" />
            <scottplot:WpfPlot x:Name="KdjPlot" Grid.Row="4" MinHeight="70" />
        </Grid>
    </DockPanel>
</Page>