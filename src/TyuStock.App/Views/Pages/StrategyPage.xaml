<Page x:Class="TyuStock.App.Views.Pages.StrategyPage"
      AutomationProperties.AutomationId="StrategyPageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Page.Resources>
        <Style x:Key="RangeChip" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="MinRowHeight" Value="32" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,8" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="32,20,32,8">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource St_Title}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource St_Desc}" Margin="0,0,0,12" />
            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource St_Refresh}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="14,6" Margin="8,0,0,0"
                           Command="{Binding LoadFromBoxCommand}" Content="{DynamicResource St_Load}" />
                <ComboBox x:Name="ExpirationBox" AutomationProperties.AutomationId="StrategyExpiration"
                          DockPanel.Dock="Right" MinWidth="200" FontSize="14" Margin="8,0,0,0"
                          ItemsSource="{Binding Expirations}"
                          SelectedItem="{Binding SelectedExpiration}"
                          DisplayMemberPath="Label" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="12,0,0,0" Text="{DynamicResource St_Expiration}" />
                <ComboBox x:Name="SymbolBox" AutomationProperties.AutomationId="StrategySymbol"
                          MinWidth="160" FontSize="14" IsEditable="True" StaysOpenOnEdit="True"
                          ItemsSource="{Binding WatchSymbols}"
                          Text="{Binding SymbolText, UpdateSourceTrigger=PropertyChanged}"
                          KeyDown="OnSymbolKeyDown" />
            </DockPanel>
            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding Headline}" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Left" Margin="12,0,0,0" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Visibility="{Binding HasDelay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DelayText}" />
                </Border>
                <!-- F5: pricing model and risk-free rate used for local IV / Greeks -->
                <Border DockPanel.Dock="Left" Margin="8,0,0,0" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" ToolTip="{DynamicResource Px_ModelTip}">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ModelText}" />
                </Border>
            </DockPanel>
            <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource St_Preset}" />
                <ComboBox MinWidth="200" FontSize="14" Margin="0,0,16,0"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Label" />
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource St_Quantity}" />
                <ui:NumberBox Value="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="1000"
                              SpinButtonPlacementMode="Compact" FontSize="14" Width="90" Margin="0,0,16,0" />
                <ui:Button Appearance="Secondary" Padding="12,6" Command="{Binding ApplyPresetCommand}"
                           Content="{DynamicResource St_ApplyPreset}" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" Text="{DynamicResource St_Horizon}" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_TnNow}" Tag="0" Click="OnHorizonClick" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_Tn7}" Tag="7" Click="OnHorizonClick" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_Tn14}" Tag="14" Click="OnHorizonClick" />
                <Button Style="{StaticResource RangeChip}" Content="{DynamicResource St_Tn30}" Tag="30" Click="OnHorizonClick" />
            </WrapPanel>
            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                <ui:ProgressRing DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding LocalNote}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="32,0,32,8" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="{DynamicResource St_Legs}" Margin="0,0,0,6" />
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <ui:Button Appearance="Secondary" Padding="10,6" Margin="0,0,8,0" Command="{Binding AddCallCommand}" Content="{DynamicResource St_AddCall}" />
                <ui:Button Appearance="Secondary" Padding="10,6" Margin="0,0,8,0" Command="{Binding AddPutCommand}" Content="{DynamicResource St_AddPut}" />
                <ui:Button Appearance="Secondary" Padding="10,6" Margin="0,0,8,0" Command="{Binding AddStockCommand}" Content="{DynamicResource St_AddStock}" />
                <ui:Button Appearance="Secondary" Padding="10,6" Command="{Binding RemoveLegCommand}" Content="{DynamicResource St_RemoveLeg}" />
            </WrapPanel>
            <DataGrid x:Name="LegsGrid" AutomationProperties.AutomationId="StrategyLegs"
                      ItemsSource="{Binding Legs}" SelectedItem="{Binding SelectedLeg}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      MaxHeight="220" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{DynamicResource St_Type}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TypeLabel}" FontSize="13" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox FontSize="13"
                                          ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource St_Side}" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SideLabel}" FontSize="13" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox FontSize="13"
                                          ItemsSource="{Binding DataContext.SideChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedValue="{Binding Side, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource St_Strike}" Binding="{Binding StrikeText, UpdateSourceTrigger=LostFocus}" Width="90" />
                    <DataGridTextColumn Header="{DynamicResource St_Premium}" Binding="{Binding PremiumText, UpdateSourceTrigger=LostFocus}" Width="90" />
                    <DataGridTextColumn Header="{DynamicResource St_IV}" Binding="{Binding IvText, UpdateSourceTrigger=LostFocus}" Width="70" />
                    <DataGridTextColumn Header="{DynamicResource St_Qty}" Binding="{Binding QtyText, UpdateSourceTrigger=LostFocus}" Width="70" />
                    <DataGridTextColumn Header="{DynamicResource St_Expiry}" Binding="{Binding ExpiryText, UpdateSourceTrigger=LostFocus}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <UniformGrid DockPanel.Dock="Top" Margin="32,0,32,8" Columns="4" Rows="2">
            <StackPanel Margin="0,0,16,8">
                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_Cost}" />
                <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding CostText}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_MaxProfit}" />
                <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding MaxProfitText}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_MaxLoss}" />
                <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding MaxLossText}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource St_Breakeven}" />
                <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding BreakevenText}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding RewardText}" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding GreeksText}" />
        </UniformGrid>
        <Grid Margin="16,0,16,16">
            <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="{DynamicResource St_NoLegs}"
                       Visibility="{Binding HasCurve, Converter={StaticResource InverseBoolToVis}}" />
            <scottplot:WpfPlot x:Name="PayoffPlot" AutomationProperties.AutomationId="StrategyChart"
                               Visibility="{Binding HasCurve, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </DockPanel>
</Page>