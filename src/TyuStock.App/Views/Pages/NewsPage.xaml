<Page x:Class="TyuStock.App.Views.Pages.NewsPage"
      AutomationProperties.AutomationId="NewsPageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Resources>
        <Style x:Key="RangeChip" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FinCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <DataTemplate x:Key="StatementTemplate">
            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{Binding Title}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Nf_Item}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding H0}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding H1}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="{Binding H2}" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="{Binding H3}" TextAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="13" Text="{Binding Label}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource FinCell}" Text="{Binding V0}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource FinCell}" Text="{Binding V1}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource FinCell}" Text="{Binding V2}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource FinCell}" Text="{Binding V3}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="32,20,32,8">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nf_Title}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Nf_Desc}" Margin="0,0,0,12" />
            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Nf_Refresh}" FontSize="14" />
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Padding="14,6" Margin="8,0,0,0"
                           Command="{Binding LoadFromBoxCommand}" Content="{DynamicResource Nf_Load}" />
                <ComboBox x:Name="SymbolBox" AutomationProperties.AutomationId="NewsSymbol"
                          MinWidth="200" FontSize="14" IsEditable="True" StaysOpenOnEdit="True"
                          ItemsSource="{Binding WatchSymbols}"
                          Text="{Binding SymbolText, UpdateSourceTrigger=PropertyChanged}"
                          KeyDown="OnSymbolKeyDown" />
            </DockPanel>
            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                <TextBlock Style="{StaticResource CardTitle}" FontSize="18" Text="{Binding Headline}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock DockPanel.Dock="Right" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource NumberFont}"
                           Text="{Binding ChangeText}" Foreground="{Binding ChangeBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </DockPanel>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding MetaText}" Margin="0,0,0,6" />
            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                <ui:ProgressRing DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <Grid Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" MinWidth="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Style="{StaticResource PageScroller}" Grid.Column="0">
                <StackPanel Margin="16,0,8,8">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Nf_Stats}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="150" Margin="0,0,16,12">
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" />
                                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding Value}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Nf_Profile}" Margin="0,8,0,8" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Nf_NoProfile}"
                               Visibility="{Binding HasProfile, Converter={StaticResource InverseBoolToVis}}" />
                    <StackPanel Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4"
                                   Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVis}}">
                            <Run Text="{DynamicResource Nf_Website}" />
                            <Run Text="  " />
                            <Hyperlink Command="{Binding OpenWebsiteCommand}">
                                <Run Text="{Binding WebsiteText}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Description}" TextWrapping="Wrap" FontSize="14" />
                    </StackPanel>

                    <DockPanel Margin="0,16,0,8">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Nf_Financials}" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource RangeChip}" Content="{DynamicResource Nf_Annual}" Tag="annual" Click="OnPeriodClick" />
                            <Button Style="{StaticResource RangeChip}" Content="{DynamicResource Nf_Quarterly}" Tag="quarterly" Click="OnPeriodClick" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource Nf_NoFinancials}"
                               Visibility="{Binding HasFinancials, Converter={StaticResource InverseBoolToVis}}" />
                    <StackPanel Visibility="{Binding HasFinancials, Converter={StaticResource BoolToVis}}">
                        <ContentPresenter Content="{Binding Income}" ContentTemplate="{StaticResource StatementTemplate}" Margin="0,0,0,12" />
                        <ContentPresenter Content="{Binding Balance}" ContentTemplate="{StaticResource StatementTemplate}" Margin="0,0,0,12" />
                        <ContentPresenter Content="{Binding CashFlow}" ContentTemplate="{StaticResource StatementTemplate}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="{DynamicResource Nf_News}" Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Text="{DynamicResource Nf_NoNews}"
                           Visibility="{Binding HasNews, Converter={StaticResource InverseBoolToVis}}" />
                <ListView x:Name="NewsList" AutomationProperties.AutomationId="NewsList"
                          ItemsSource="{Binding News}" BorderThickness="0"
                          Visibility="{Binding HasNews, Converter={StaticResource BoolToVis}}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="OnNewsDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,10" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top"
                                        Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        FontSize="13" Padding="10,6" Content="{DynamicResource Nf_OpenArticle}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" ToolTip="{Binding TimeTip}">
                                        <Run Text="{Binding Publisher}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding TimeText}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Page>