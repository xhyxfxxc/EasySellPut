<Page x:Class="TyuStock.App.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="1200">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Dashboard}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{DynamicResource App_Subtitle}" Margin="0,0,0,16" />

            <!-- Hero -->
            <ui:Card Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/app-64.png" Width="56" Height="56" Margin="0,0,20,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="20" Text="{DynamicResource Dash_Welcome}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" Text="{DynamicResource Dash_WelcomeBody}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Market overview (quotes via failover) -->
            <DockPanel Margin="0,24,0,8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource Dash_Market}" />
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Command="{Binding RefreshCommand}" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Dash_Refresh}" />
                    </StackPanel>
                </ui:Button>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding StatusText}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Quotes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,8,8" Padding="18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Symbol}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SourceText}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,8" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding PriceText}" FontFamily="{StaticResource NumberFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="4" Padding="8,2" Background="{Binding ChangeBackground}">
                                        <TextBlock Text="{Binding ChangeText}" FontFamily="{StaticResource NumberFont}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ChangeBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding ExtText}" />
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
