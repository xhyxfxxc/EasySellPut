<ui:FluentWindow x:Class="TyuStock.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:TyuStock.App.Views.Pages"
                 Title="{DynamicResource App_Title}"
                 Width="1320" Height="840" MinWidth="980" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource AppFont}"
                 FontSize="14"
                 Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="{DynamicResource App_Title}" Height="44">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-64.png" Width="18" Height="18" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:Button x:Name="LanguageButton" Appearance="Transparent" Padding="10,4" MinWidth="40" Height="32"
                               FontSize="14" FontWeight="SemiBold"
                               Content="{DynamicResource Title_LanguageButton}"
                               ToolTip="{DynamicResource Title_ToggleLanguage}"
                               Click="OnToggleLanguage" />
                    <ui:Button x:Name="ThemeButton" Appearance="Transparent" Padding="8,4" Height="32" Margin="4,0,0,0"
                               ToolTip="{DynamicResource Title_ToggleTheme}" Click="OnToggleTheme">
                        <ui:SymbolIcon x:Name="ThemeIcon" Symbol="WeatherMoon24" FontSize="18" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="232"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           FrameMargin="0"
                           Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Dashboard}" TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Watchlist}" TargetPageType="{x:Type pages:WatchlistPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Star24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Charts}" TargetPageType="{x:Type pages:ChartsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DataHistogram24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Options}" TargetPageType="{x:Type pages:OptionsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="TableSimple24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Strategy}" TargetPageType="{x:Type pages:StrategyPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DataTrending24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_News}" TargetPageType="{x:Type pages:NewsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="News24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Alerts}" TargetPageType="{x:Type pages:AlertsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Alert24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{DynamicResource Nav_DataSources}" TargetPageType="{x:Type pages:DataSourcesPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="PlugConnected24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Settings}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="16,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding SessionBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding SessionText}" FontWeight="SemiBold" Margin="0,0,14,0" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ClockText}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding NetworkText}" Margin="0,0,18,0" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DataDirText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
